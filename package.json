{
  "name": "fintrace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/contracts",
    "packages/data"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx apps/api/src/server.ts",
    "dev:web": "npm run dev --workspace apps/web",
    "build": "npm run build --workspace apps/web",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace apps/web",
    "test": "vitest run",
    "test:browser": "playwright test",
    "preflight": "tsx scripts/preflight.ts",
    "preflight:submission": "tsx scripts/preflight.ts --submission",
    "prepare:manual": "tsx scripts/prepare_openai_manual.ts",
    "verify:openai": "tsx scripts/verify_openai_manual.ts",
    "prepare:hmem-demo": "tsx scripts/prepare_hmem_demo.ts",
    "verify:hmem": "tsx scripts/verify_hmem.ts",
    "verify:business": "tsx scripts/verify_business_cases.ts",
    "evaluate": "tsx apps/api/src/cli.ts evaluate",
    "investigate": "tsx apps/api/src/cli.ts investigate",
    "db:init": "tsx apps/api/src/cli.ts db-init"
  },
  "dependencies": {
    "@fastify/cors": "11.0.1",
    "@fastify/static": "8.1.1",
    "csv-parse": "5.6.0",
    "decimal.js": "10.5.0",
    "dotenv": "16.5.0",
    "fastify": "5.3.2",
    "pg": "8.16.0",
    "zod": "3.24.4"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.15.18",
    "@types/pg": "8.15.2",
    "prettier": "3.5.3",
    "tsx": "4.19.4",
    "typescript": "5.8.3",
    "vitest": "3.1.3"
  }
}
