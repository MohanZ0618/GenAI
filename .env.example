# Copy to .env.local. Keep credentials out of source control and chat.
# fixture = offline rules; local-model = real model + local data; live = Zetaris + model.
FINTRACE_MODE=fixture
PORT=4310
HOST=127.0.0.1
FINTRACE_STORAGE_DIR=
DATABASE_URL=postgresql://fintrace:local-development-only@127.0.0.1:5432/fintrace
ZETARIS_BASE_URL=
ZETARIS_ORG_ID=
ZETARIS_API_KEY=
ZETARIS_ENGINE_ID=
ZETARIS_QUERY_LIMIT=1000
ZETARIS_TABLE_PREFIX=FINTRACE.
MODEL_PROVIDER=openai
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=
METERLESS_MODEL=
